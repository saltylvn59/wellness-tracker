# Copy this file to .env.local and fill in the values (Supabase dashboard ->
# Project Settings -> API). .env.local is git-ignored; this example file is not.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# AI food estimates (server-side only: no NEXT_PUBLIC_ prefix, never expose to the browser).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key
# Optional: override the Gemini model if Google renames or retires the default.
# GEMINI_MODEL=gemini-3.8-flash
